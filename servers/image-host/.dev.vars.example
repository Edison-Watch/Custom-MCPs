# Copy to `.dev.vars` for `wrangler dev`. NEVER commit `.dev.vars` (it is gitignored).
#
# Clients must present this as `Authorization: Bearer <token>`.
AUTH_TOKEN="dev-local-token-change-me"

# Absolute base for returned URLs. Under `wrangler dev` this is usually:
PUBLIC_BASE_URL="http://localhost:8787"

# Optional overrides:
# AUTH_MODE="bearer"            # open | bearer | edison-jwt
# KEY_PREFIX="img"
# MAX_UPLOAD_BYTES="10485760"   # 10 MiB

# edison-jwt mode (Edison mints a per-user JWT and injects it; verified against
# Edison's published JWKS - see src/jwt.ts). Set AUTH_MODE="edison-jwt" and all
# three below (none are secrets - public config):
# EDISON_JWKS_URL="https://<edison-host>/.well-known/jwks.json"
# EDISON_JWT_ISSUER="https://<edison-host>"
# EDISON_JWT_AUDIENCE="image-host"
